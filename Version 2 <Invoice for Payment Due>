function processAllPendingEmails() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.SHEET_NAME);
  var data = sheet.getDataRange().getValues();
  
  var groups = {};
  
  for (var i = 1; i < data.length; i++) {
    var status = data[i][COL.STATUS];
    var emailSent = data[i][COL.EMAIL_SENT];
    var clientEmail = data[i][COL.CLIENT_EMAIL];
    var submittedDate = formatDateForCompare(data[i][COL.SUBMITTED_DATE]);
    
    var expectedEmailStatus = status === 'Paid' ? 'Confirmation Sent' : 'Reminder Sent';
    
    if ((status === 'Paid' || status === 'Reminder') && emailSent !== expectedEmailStatus) {
      
      if (status === 'Paid') {
        var paymentDate = data[i][COL.DATE_OF_PAYMENT];
        var paymentType = data[i][COL.PAYMENT_TYPE];
        if (!paymentDate || !paymentType) {
          console.log('Skipping row ' + (i + 1) + ': Missing payment details');
          continue;
        }
      }
      
      var key = clientEmail + '|' + submittedDate + '|' + status;
      
      if (!groups[key]) {
        groups[key] = [];
      }
      
      groups[key].push({
        rowIndex: i + 1,
        submittedDate: data[i][COL.SUBMITTED_DATE],
        client: data[i][COL.CLIENT],
        clientEmail: data[i][COL.CLIENT_EMAIL],
        publication: data[i][COL.PUBLICATION],
        businessType: data[i][COL.BUSINESS_TYPE],
        rateType: data[i][COL.RATE_TYPE],
        title: data[i][COL.TITLE],
        doclink: data[i][COL.DOCLINK],
        wordCount: data[i][COL.WORD_COUNT],
        rate: data[i][COL.RATE],
        amount: data[i][COL.AMOUNT],
        status: status,
        dateOfPayment: data[i][COL.DATE_OF_PAYMENT],
        paymentType: data[i][COL.PAYMENT_TYPE],
        invoiceNum: data[i][COL.INVOICE_NUM]
      });
    }
  }
  
  var remindersCount = 0;
  var confirmationsCount = 0;
  
  for (var key in groups) {
    var articles = groups[key];
    var status = articles[0].status;
    
    if (status === 'Reminder') {
      var result = sendConsolidatedReminder(articles);
      if (result.success) {
        articles.forEach(function(a) {
          sheet.getRange(a.rowIndex, COL.EMAIL_SENT + 1).setValue('Reminder Sent');
          sheet.getRange(a.rowIndex, COL.INVOICE_NUM + 1).setValue(result.invoiceNumber);
          sheet.getRange(a.rowIndex, COL.INVOICE_LINK + 1).setValue(result.invoiceUrl);
        });
        remindersCount += articles.length;
      }
    } else if (status === 'Paid') {
      var result = sendConsolidatedConfirmation(articles);
      if (result.success) {
        articles.forEach(function(a) {
          sheet.getRange(a.rowIndex, COL.EMAIL_SENT + 1).setValue('Confirmation Sent');
          sheet.getRange(a.rowIndex, COL.INVOICE_NUM + 1).setValue(result.invoiceNumber);
          sheet.getRange(a.rowIndex, COL.INVOICE_LINK + 1).setValue(result.invoiceUrl);
        });
        confirmationsCount += articles.length;
      }
    }
    
    Utilities.sleep(1000);
  }
  
  SpreadsheetApp.getUi().alert(
    '✅ Batch Processing Complete',
    'Reminders sent: ' + remindersCount + ' article(s)\nConfirmations sent: ' + confirmationsCount + ' article(s)'
  );
}

