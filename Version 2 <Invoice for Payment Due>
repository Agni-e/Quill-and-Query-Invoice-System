/**
 * Simple onEdit - For calculations (cannot send emails)
 */
function onEdit(e) {
  try {
    const sheet = e.source.getActiveSheet();
    const range = e.range;
    const row = range.getRow();
    const col = range.getColumn();
    
    if (row === 1 || sheet.getName() !== CONFIG.SHEET_NAME) return;
    
    // Auto-calculate amount based on rate type
    if (col === COL.RATE_TYPE + 1 || col === COL.WORD_COUNT + 1 || col === COL.RATE + 1) {
      autoCalculateAmount(sheet, row);
    }
  } catch (error) {
    console.error('onEdit error:', error);
  }
}

/**
 * Installable onEdit - For emails and Drive access (needs trigger setup)
 */
function onEditInstallable(e) {
  try {
    const sheet = e.source.getActiveSheet();
    const range = e.range;
    const row = range.getRow();
    const col = range.getColumn();
    
    if (row === 1) return;
    if (sheet.getName() !== CONFIG.SHEET_NAME) return;
    
    // If Amount column is edited → Generate Invoice #
    if (col === COL.AMOUNT + 1) {
      const amount = range.getValue();
      const invoiceCell = sheet.getRange(row, COL.INVOICE_NUM + 1);
      
      if (amount && !invoiceCell.getValue()) {
        const publication = sheet.getRange(row, COL.PUBLICATION + 1).getValue();
        const invoiceNum = generateInvoiceNumber(publication);
        invoiceCell.setValue(invoiceNum);
      }
    }
    
    // If Status column is edited → Process with consolidation
    if (col === COL.STATUS + 1) {
      const newStatus = range.getValue();
      const emailSent = sheet.getRange(row, COL.EMAIL_SENT + 1).getValue();
      
      if (newStatus === 'Paid' && emailSent !== 'Confirmation Sent') {
        Utilities.sleep(500);
        processStatusChange(sheet, row, 'Paid');
      } else if (newStatus === 'Reminder' && emailSent !== 'Reminder Sent') {
        Utilities.sleep(500);
        processStatusChange(sheet, row, 'Reminder');
      }
    }
  } catch (error) {
    console.error('onEditInstallable error:', error);
  }
}

// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║                    INVOICE NUMBER GENERATOR                                ║
// ╚═══════════════════════════════════════════════════════════════════════════╝

function generateInvoiceNumber(publication) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.SHEET_NAME);
  const data = sheet.getDataRange().getValues();
  
  let maxNum = 0;
  const prefix = CONFIG.INVOICE_PREFIX;
  
  for (let i = 1; i < data.length; i++) {
    const invoiceNum = data[i][COL.INVOICE_NUM];
    if (invoiceNum && invoiceNum.toString().startsWith(prefix)) {
      const match = invoiceNum.toString().match(/-(\d{4})-/);
      if (match) {
        const num = parseInt(match[1]);
        if (num > maxNum) maxNum = num;
      }
    }
  }
  
  const date = new Date();
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  const sequence = String(maxNum + 1).padStart(4, '0');
  
  // Clean publication name (remove special characters)
  const cleanPublication = publication ? 
    publication.toString().replace(/[^a-zA-Z0-9\s]/g, '').replace(/\s+/g, '') : 
    'General';
  
  return prefix + year + month + day + '-' + sequence + '-' + cleanPublication;
}

// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║                    PROCESS STATUS CHANGE                                   ║
// ║              (With Payment Validation & Consolidation)                     ║
// ╚═══════════════════════════════════════════════════════════════════════════╝

function processStatusChange(sheet, triggerRow, status) {
  const data = sheet.getDataRange().getValues();
  const triggerRowData = data[triggerRow - 1];
  
  const clientEmail = triggerRowData[COL.CLIENT_EMAIL];
  const submittedDate = triggerRowData[COL.SUBMITTED_DATE];
  const triggerDateStr = formatDateForCompare(submittedDate);
  
  // ===== VALIDATION FOR PAID STATUS =====
  if (status === 'Paid') {
    const dateOfPayment = triggerRowData[COL.DATE_OF_PAYMENT];
    const paymentType = triggerRowData[COL.PAYMENT_TYPE];
    
    if (!dateOfPayment || !paymentType) {
      SpreadsheetApp.getActiveSpreadsheet().toast(
        '⚠️ Please fill "Date of Payment" and "Payment Type" before marking as Paid.',
        '❌ Missing Payment Details',
        10
      );
      
      // Reset status to "Not paid"
      sheet.getRange(triggerRow, COL.STATUS + 1).setValue('Not paid');
      return;
    }
  }
  // ===== END VALIDATION =====
  
  const matchingArticles = [];
  const matchingRows = [];
  
  const expectedEmailStatus = status === 'Paid' ? 'Confirmation Sent' : 'Reminder Sent';
  
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const rowEmail = row[COL.CLIENT_EMAIL];
    const rowDate = formatDateForCompare(row[COL.SUBMITTED_DATE]);
    const rowStatus = row[COL.STATUS];
    const rowEmailSent = row[COL.EMAIL_SENT];
    
    if (rowEmail === clientEmail && 
        rowDate === triggerDateStr && 
        rowStatus === status && 
        rowEmailSent !== expectedEmailStatus) {
      
      // For Paid status, validate all matching rows have payment details
      if (status === 'Paid') {
        const rowPaymentDate = row[COL.DATE_OF_PAYMENT];
        const rowPaymentType = row[COL.PAYMENT_TYPE];
        
        if (!rowPaymentDate || !rowPaymentType) {
          SpreadsheetApp.getActiveSpreadsheet().toast(
            '⚠️ Row ' + (i + 1) + ' is missing payment details. Please fill all payment info.',
            '❌ Missing Payment Details',
            10
          );
          return;
        }
      }
      
      matchingArticles.push({
        rowIndex: i + 1,
        submittedDate: row[COL.SUBMITTED_DATE],
        client: row[COL.CLIENT],
        clientEmail: row[COL.CLIENT_EMAIL],
        publication: row[COL.PUBLICATION],
        businessType: row[COL.BUSINESS_TYPE],
        rateType: row[COL.RATE_TYPE],
        title: row[COL.TITLE],
        doclink: row[COL.DOCLINK],
        wordCount: row[COL.WORD_COUNT],
        rate: row[COL.RATE],
        amount: row[COL.AMOUNT],
        dateOfPayment: row[COL.DATE_OF_PAYMENT],
        paymentType: row[COL.PAYMENT_TYPE],
        invoiceNum: row[COL.INVOICE_NUM]
      });
      matchingRows.push(i + 1);
    }
  }
  
  if (matchingArticles.length === 0) return;
  
  console.log('Found ' + matchingArticles.length + ' articles for ' + clientEmail + ' on ' + triggerDateStr);
  
  let success = false;
  let invoiceNumber = null;
  let invoiceUrl = null;
  
  if (status === 'Reminder') {
    const result = sendConsolidatedReminder(matchingArticles);
    success = result.success;
    invoiceNumber = result.invoiceNumber;
    invoiceUrl = result.invoiceUrl;
  } else if (status === 'Paid') {
    const result = sendConsolidatedConfirmation(matchingArticles);
    success = result.success;
    invoiceNumber = result.invoiceNumber;
    invoiceUrl = result.invoiceUrl;
  }
  
  if (success) {
    const emailStatus = status === 'Paid' ? 'Confirmation Sent' : 'Reminder Sent';
    
    matchingRows.forEach(function(rowNum) {
      sheet.getRange(rowNum, COL.EMAIL_SENT + 1).setValue(emailStatus);
      
      if (invoiceNumber) {
        sheet.getRange(rowNum, COL.INVOICE_NUM + 1).setValue(invoiceNumber);
      }
      
      // Save Invoice Link to sheet
      if (invoiceUrl) {
        sheet.getRange(rowNum, COL.INVOICE_LINK + 1).setValue(invoiceUrl);
      }
    });
    
    SpreadsheetApp.getActiveSpreadsheet().toast(
      (status === 'Paid' ? 'Confirmation' : 'Reminder') + ' with invoice sent to ' + matchingArticles[0].client + ' (' + matchingArticles.length + ' article' + (matchingArticles.length > 1 ? 's' : '') + ')',
      '✅ Email Sent',
      5
    );
  }
}

